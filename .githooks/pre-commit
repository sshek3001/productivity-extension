#!/usr/bin/env bash
# Blocks commits that add secrets (API keys, tokens, private keys, or gitignored secret files).
# Installed via: git config core.hooksPath .githooks

set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

found=0

# 1. Block known secret files even if `git add -f` was used to bypass .gitignore.
blocked_files='^(\.env(\..*)?|secrets\.local\.js|.*\.pem|.*\.key|.*id_rsa.*)$'
while IFS= read -r file; do
  basename=$(basename -- "$file")
  if echo "$basename" | grep -Eq "$blocked_files"; then
    echo "pre-commit: blocked secret file staged: $file"
    found=1
  fi
done <<< "$staged_files"

# 2. Scan staged diff content for common secret patterns.
patterns=(
  'AKIA[0-9A-Z]{16}'                                   # AWS access key ID
  'AIza[0-9A-Za-z_-]{35}'                              # Google API key
  'sk-[A-Za-z0-9]{20,}'                                # OpenAI-style secret key
  'sk-ant-[A-Za-z0-9_-]{20,}'                          # Anthropic API key
  'ghp_[A-Za-z0-9]{36}'                                # GitHub personal access token
  'gh[oprsu]_[A-Za-z0-9]{36}'                          # Other GitHub tokens
  'xox[baprs]-[A-Za-z0-9-]{10,}'                       # Slack token
  '-----BEGIN (RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY-----' # Private keys
  '(api|secret|access|private)[_-]?key["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_/+=]{16,}["'"'"']' # generic assigned keys
)

diff_content=$(git diff --cached -U0 -- . ":(exclude).githooks/*")

for pattern in "${patterns[@]}"; do
  if echo "$diff_content" | grep -Eiq "$pattern" 2>/dev/null; then
    echo "pre-commit: potential secret matching pattern '$pattern' found in staged changes"
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  echo ""
  echo "Commit blocked. Remove the secret (or move it to .env / secrets.local.js, which are gitignored)."
  echo "If this is a false positive, use 'git commit --no-verify' to bypass (only if you are certain)."
  exit 1
fi

exit 0
